        task.spawn(function()
            for i = 1, 10 do
                -- หากมีตัวละครและกระเป๋า
                local backpack = localPlayer:FindFirstChild("Backpack")
                if backpack then
                    for _, item in ipairs(backpack:GetChildren()) do
                        if dropRemote then
                            -- ยิงรีโมตเพื่อทิ้งไอเทมชิ้นนั้นๆ
                            dropRemote:FireServer(item)
                        else
                            -- วิธีสำรอง: สั่งให้ตัวละครหยิบของออกจากกระเป๋ามาไว้ในมือแล้วทิ้ง
