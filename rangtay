                            if char and localPlayer.Humanoid then
                                localPlayer.Humanoid:EquipTool(item)
                                task.wait(0.05)
                            end
                        end
                    end
                end
                task.wait(0.1) -- หน่วงเวลาเล็กน้อยกันเกมบัณทึกหรือดีด (Anti-Spam)
            end
        end)
