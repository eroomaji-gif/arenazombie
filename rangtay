-- ฟังก์ชันหาหัวของมอนสเตอร์ที่อยู่ใกล้ที่สุด
local function getClosestMonsterHead()
    local closestHead = nil
    local shortestDistance = math.huge
    
    if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    
    local rootPart = localPlayer.Character.HumanoidRootPart

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("Head") then
            -- เช็คว่าไม่ใช่ตัวผู้เล่นคนอื่น (คัดเฉพาะมอนสเตอร์/NPC)
            local isPlayer = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character == obj then
                    isPlayer = true
                    break
                end
            end
            
            if not isPlayer and obj.Humanoid.Health > 0 then
                local head = obj.Head
                local distance = (head.Position - rootPart.Position).Magnitude
                
                if distance < shortestDistance and distance <= 150 then
                    shortestDistance = distance
                    closestHead = head
                end
            end
        end
    end
    
    return closestHead
end

-- ลูปการทำงานล็อกเป้าหมาย
RunService.RenderStepped:Connect(function()
    if not getgenv().AutoLockHead then return end
    
    pcall(function()
        local targetHead = getClosestMonsterHead()
        if targetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end)
end)

