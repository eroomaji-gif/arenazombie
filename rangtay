    pcall(function()
        -- ค้นหา RemoteEvent ที่เกี่ยวข้องกับการทิ้งของ (Drop, Toss, Dispose หรือ Backpack)
        local dropRemote = nil
        for _, descendant in ipairs(game:GetDescendants()) do
            local nameLower = descendant.Name:lower()
            if (nameLower:find("drop") or nameLower:find("toss") or nameLower:find("inventory") or nameLower:find("item")) 
