-- 💀 ฟังก์ชัน: คิวทุกสิ่งมีชีวิต (ยกเว้นตัวเราและเพื่อนร่วมทีม)
-- ==========================================

_G.KillAllEntities = false

local function createKillAllButton(parentPage, text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = parentPage
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = text .. " [ OFF ]"
    btn.TextColor3 = Color3.fromRGB(255, 100, 100)
    btn.TextSize = 14
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        _G.KillAllEntities = not _G.KillAllEntities
        if _G.KillAllEntities then
            btn.Text = text .. " [ ON ]"
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
        else
            btn.Text = text .. " [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
        callback(_G.KillAllEntities)
    end)
end

-- สร้างปุ่มลงในหน้า AutoRatePage ของคุณ
createKillAllButton(AutoRatePage, "💀 คิวทุกสิ่งมีชีวิต", function(state)
    _G.KillAllEntities = state
end)

-- ==========================================
-- ⚙️ ระบบเบื้องหลัง: กวาดล้างศัตรู (ยกเว้นผู้เล่นทั้งหมด)
-- ==========================================
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer

task.spawn(function()
    while true do
        task.wait(0.2)
        if _G.KillAllEntities then
            pcall(function()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                local attackEvent = remotes and (remotes:FindFirstChild("Attack") or remotes:FindFirstChild("Damage") or remotes:FindFirstChild("GunHit") or remotes:FindFirstChild("Kill"))
                
                -- วนหาทุกสิ่งมีชีวิตใน Workspace
                for _, enemy in ipairs(Workspace:GetDescendants()) do
                    if enemy:IsA("Model") then
                        -- เช็คว่าตัวนี้ไม่ใช่ผู้เล่น (Players) เพื่อป้องกันไม่ให้โจมตีตัวเราเองหรือผู้เล่นคนอื่น
                        local isPlayer = Players:GetPlayerFromCharacter(enemy)
                        
                        if not isPlayer then
                            local humanoid = enemy:FindFirstChildOfClass("Humanoid")
                            local rootPart = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
                            
                            -- ถ้ามีชีวิตอยู่และมีตัวตนจริง ให้ส่งรีโมทจัดการ
                            if humanoid and humanoid.Health > 0 and rootPart then
                                if attackEvent then
                                    attackEvent:FireServer(enemy)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)








