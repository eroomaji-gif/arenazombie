_G.KillAllEntities = false

local function createKillAllButton(parentPage, text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = parentPage
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = text .. " [ OFF ]"
    btn.TextColor3 = Color3.fromRGB(255, 100, 100)
    btn.TextSize = 14
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        _G.KillAllEntities = not _G.KillAllEntities
        if _G.KillAllEntities then
            btn.Text = text .. " [ ON ]"
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
        else
            btn.Text = text .. " [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
        callback(_G.KillAllEntities)
    end)
end

-- สร้างปุ่มลงในหน้า AutoRatePage ของคุณ
