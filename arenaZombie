-- ลูปการทำงาน (ทำงานเฉพาะตอนเปิดปุ่ม ON เท่านั้น)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

-- 1. ลูปเช็คถือปืน
task.spawn(function()
    while true do
        task.wait(0.5)
        if _G.AutoEquipGun then
            pcall(function()
                local char = localPlayer.Character
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                local backpack = localPlayer:FindFirstChildOfClass("Backpack")
                
                if char and humanoid and humanoid.Health > 0 then
                    local currentTool = char:FindFirstChildOfClass("Tool")
                    if not currentTool and backpack then
                        for _, item in ipairs(backpack:GetChildren()) do
                            if item:IsA("Tool") then
                                humanoid:EquipTool(item)
                                break
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- 2. ลูปยิงอัตโนมัติ
task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.AutoShoot then
            pcall(function()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                local gunFireEvent = remotes and remotes:FindFirstChild("GunFire")
                if gunFireEvent then
                    gunFireEvent:FireServer("Minigin")
                end
            end)
        end
    end
end)

-- 3. ลูปข้ามคลื่นอัตโนมัติ
task.spawn(function()
    while true do
        task.wait(1)
        if _G.AutoSkipWave then
            pcall(function()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                local skipEvent = remotes and remotes:FindFirstChild("SkipVote")
                if skipEvent then
                    skipEvent:FireServer(true)
                end
            end)
        end
    end
end)



