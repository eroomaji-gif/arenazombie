-- ⚙️ ระบบเบื้องหลัง: ดักจับและกำจัดทันทีที่เกิด
-- ==========================================
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer

local function processEntity(enemy)
    if not _G.KillAllEntities then return end
    pcall(function()
        if enemy:IsA("Model") then
            local isPlayer = Players:GetPlayerFromCharacter(enemy)
            if not isPlayer then
                local humanoid = enemy:WaitForChild("Humanoid", 1)
                local rootPart = enemy:WaitForChild("HumanoidRootPart", 1) or enemy.PrimaryPart
                
                if humanoid and humanoid.Health > 0 then
                    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                    local attackEvent = remotes and (remotes:FindFirstChild("Attack") or remotes:FindFirstChild("Damage") or remotes:FindFirstChild("GunHit") or remotes:FindFirstChild("Kill") or remotes:FindFirstChild("Hit"))
                    
                    if attackEvent then
                        -- ส่งดาเมจสูงสุดหรือสั่งฆ่าทันทีที่เกิด
                        attackEvent:FireServer(enemy, 999999)
                        attackEvent:FireServer(enemy, humanoid.MaxHealth)
                    end
                    
                    -- เอฟเฟคระเบิดแสงทันทีที่เกิด
                    if rootPart and not rootPart:FindFirstChild("InstantKillLight") then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "InstantKillLight"
                        highlight.Adornee = enemy
                        highlight.FillColor = Color3.fromRGB(255, 0, 0)
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.Parent = enemy
                        
                        local light = Instance.new("PointLight")
                        light.Name = "InstantKillLight"
                        light.Color = Color3.fromRGB(255, 50, 50)
                        light.Range = 12
                        light.Brightness = 8
                        light.Parent = rootPart
                        
                        task.delay(0.2, function()
                            if highlight then highlight:Destroy() end
                            if light then light:Destroy() end
                        end)
                    end
                end
            end
        end
    end)
end

-- 1. ดักจับมอนสเตอร์ตัวใหม่ที่เพิ่งเกิดทันที (Real-time)
Workspace.DescendantAdded:Connect(function(descendant)
    if _G.KillAllEntities then
        if descendant:IsA("Model") and descendant:FindFirstChildOfClass("Humanoid") then
            processEntity(descendant)
        end
    end
end)

-- 2. ลูปสำรองกวาดล้างตัวเก่าที่อาจจะเกิดค้างอยู่
task.spawn(function()
    while true do
        task.wait(0.05)
        if _G.KillAllEntities then
            pcall(function()
                for _, enemy in ipairs(Workspace:GetDescendants()) do
                    if enemy:IsA("Model") then
                        local isPlayer = Players:GetPlayerFromCharacter(enemy)
                        if not isPlayer then
                            local humanoid = enemy:FindFirstChildOfClass("Humanoid")
                            if humanoid and humanoid.Health > 0 then
                                processEntity(enemy)
                            end
                        end
                    end
                end
            end)
        end
    end
end)







