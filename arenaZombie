local ProtectedOwners = {
    "Onsenb47162",
    "Agakami_5625",
    -- อยากเพิ่มใครอีก ก็ใส่ "ชื่อในเกม" หรือ "DisplayName" ต่อท้ายตรงนี้ได้เลย คั่นด้วยคอมม่า (,)
