local function isOwner(player)
    if not player then return false end
    -- วนลูปเช็คว่าชื่อของคนที่รัน ตรงกับใครสักคนในรายชื่อด้านบนไหม
    for _, ownerName in ipairs(ProtectedOwners) do
        if player.Name == ownerName or player.DisplayName == ownerName then
            return true
        end
    end
    return false
end

