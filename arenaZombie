-- ลูปการทำงาน (หยิบปืน + ยิง + ล็อกเป้าซอมบี้ + ฟิคตัวละคร)
RunService.RenderStepped:Connect(function()
    if not isAutoRateActive then return end
    
    local character = localPlayer.Character
    if not character then return end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    local backpack = localPlayer:FindFirstChild("Backpack")
    
    -- 1. หยิบปืนออโต้เมื่อไม่พบปืนในมือ
    local equippedTool = character:FindFirstChildOfClass("Tool")
    if not equippedTool and backpack then
        local minigun = backpack:FindFirstChild("Minigun")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if minigun and humanoid then
            humanoid:EquipTool(minigun)
        end
    end

    -- 2. กดออโต้ปืนเอง (ยิงผ่าน Remote Event)
    pcall(function()
        -- local replicatedStorage = game:GetService("ReplicatedStorage")
        -- replicatedStorage.GunFire:FireServer(...)
    end)

    -- 3. ล็อกเป้าซอมบี้ + หันหน้าและฟิคตัวละครตามต้องการ
    local targetZombie = nil
    local shortestDistance = math.huge
    
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:FindFirstChild("Humanoid") and obj ~= character then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp and humanoidRootPart then
                local dist = (hrp.Position - humanoidRootPart.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    targetZombie = hrp
                end
            end
        end
    end

    if targetZombie and humanoidRootPart then
        Camera.CameraType = Enum.CameraType.Scriptable
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetZombie.Position)
        humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position, Vector3.new(targetZombie.Position.X, humanoidRootPart.Position.Y, targetZombie.Position.Z))
    end
end)

